rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasOnlyKeys(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    function userDocIsSelf() {
      return signedIn() && request.auth.uid == request.resource.id;
    }

    function isFriendshipMember() {
      return signedIn() && request.auth.uid in resource.data.memberUids;
    }

    function isFriendshipMemberOnCreate() {
      return signedIn()
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.memberUids.size() == 2;
    }

    function isFriendRequestParticipant() {
      return signedIn()
        && (
          resource.data.fromUid == request.auth.uid ||
          resource.data.toUid == request.auth.uid
        );
    }

    function isInviteParticipant() {
      return signedIn()
        && (
          resource.data.fromUid == request.auth.uid ||
          resource.data.toUid == request.auth.uid
        );
    }

    function isNotificationRecipient() {
      return signedIn() && resource.data.toUid == request.auth.uid;
    }

    function isNotificationSenderOnCreate() {
      return signedIn() && request.resource.data.fromUid == request.auth.uid;
    }

    function isOwnUserBarStatsDoc() {
      return signedIn()
        && resource.data.uid == request.auth.uid;
    }

    function isOwnUserBarStatsCreate() {
      return signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.id.matches('^' + request.auth.uid + '_.*$');
    }

    function isOwnCheckinDoc() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    function isOwnCheckinCreate() {
      return signedIn() && request.resource.data.uid == request.auth.uid;
    }

    function isOwnContent() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    function isOwnContentCreate() {
      return signedIn() && request.resource.data.uid == request.auth.uid;
    }

    function isOwnReaction() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    function isOwnReactionCreate() {
      return signedIn() && request.resource.data.uid == request.auth.uid;
    }

    function isOwnReportCreate() {
      return signedIn() && request.resource.data.reporterUid == request.auth.uid;
    }

    function isOwnHiddenCommentDoc() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    function isOwnHiddenCommentCreate() {
      return signedIn() && request.resource.data.uid == request.auth.uid;
    }

    function isOwnInviteCooldownDoc() {
      return signedIn() && resource.data.fromUid == request.auth.uid;
    }

    function isOwnInviteCooldownCreate() {
      return signedIn() && request.resource.data.fromUid == request.auth.uid;
    }

    function isOwnActiveCheckinDoc(uid) {
      return isSelf(uid);
    }

    match /users/{userId} {
      allow read: if isSelf(userId);

      allow create: if isSelf(userId)
        && request.resource.data.uid == request.auth.uid;

      allow update: if isSelf(userId)
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;

      allow delete: if isSelf(userId);
    }

    // For production, bars should be pre-seeded by you/admin and then read-only.
    match /bars/{barId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /checkins/{docId} {
      allow read: if signedIn();

      allow create: if isOwnCheckinCreate()
        && request.resource.data.dayKey is string
        && request.resource.data.barId is string
        && request.resource.data.active is bool;

      allow update: if isOwnCheckinDoc();

      allow delete: if false;
    }

    match /activeCheckins/{uid} {
      allow read, write: if isOwnActiveCheckinDoc(uid);
    }

   match /userBarStats/{docId} {
  allow read: if signedIn()
    && docId.matches('^' + request.auth.uid + '_.*$');

  allow create: if signedIn()
    && request.resource.data.uid == request.auth.uid
    && docId.matches('^' + request.auth.uid + '_.*$');

  allow update: if signedIn()
    && resource.data.uid == request.auth.uid
    && request.resource.data.uid == request.auth.uid
    && docId.matches('^' + request.auth.uid + '_.*$');

  allow delete: if false;
}

    match /userStats/{uid} {
      allow read, write: if isSelf(uid)
        && request.resource.data.uid == request.auth.uid;
    }

    match /vibes/{docId} {
      allow read: if signedIn();

      allow create: if isOwnContentCreate()
        && request.resource.data.vibe is string;

      allow update: if isOwnContent()
        && request.resource.data.uid == request.auth.uid;

      allow delete: if false;
    }

    match /coverReports/{docId} {
      allow read: if signedIn();

      allow create: if isOwnContentCreate()
        && request.resource.data.range is string;

      allow update: if isOwnContent()
        && request.resource.data.uid == request.auth.uid;

      allow delete: if false;
    }

    match /lineReports/{docId} {
      allow read: if signedIn();

      allow create: if isOwnContentCreate()
        && request.resource.data.lineLength is string;

      allow update: if isOwnContent()
        && request.resource.data.uid == request.auth.uid;

      allow delete: if false;
    }

    match /comments/{docId} {
      allow read: if signedIn();

      allow create: if isOwnContentCreate()
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 180
        && request.resource.data.hidden == false;

      allow update: if isOwnContent()
        && request.resource.data.uid == request.auth.uid;

      allow delete: if isOwnContent();
    }

    match /commentReactions/{docId} {
      allow read: if signedIn();

      allow create: if isOwnReactionCreate()
        && request.resource.data.emoji in ['🔥', '👀', '🍻'];

      allow update: if isOwnReaction()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.emoji in ['🔥', '👀', '🍻'];

      allow delete: if isOwnReaction();
    }

    match /reports/{docId} {
      allow create: if isOwnReportCreate();
      allow read: if false;
      allow update, delete: if false;
    }

    match /hiddenComments/{docId} {
      allow read: if isOwnHiddenCommentDoc();

      allow create: if isOwnHiddenCommentCreate();

      allow update: if isOwnHiddenCommentDoc()
        && request.resource.data.uid == request.auth.uid;

      allow delete: if isOwnHiddenCommentDoc();
    }

    match /friendRequests/{docId} {
      allow read: if isFriendRequestParticipant();

      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'pending';

      // lets recipient accept/decline, or either side update their own participating request safely
      allow update: if isFriendRequestParticipant()
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid;

      allow delete: if false;
    }

    match /friendships/{docId} {
      allow read: if isFriendshipMember();

      allow create: if isFriendshipMemberOnCreate();

      allow update: if false;
      allow delete: if false;
    }

    match /invites/{docId} {
      allow read: if isInviteParticipant();

      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'pending';

      // recipient can dismiss, participants can read, but keep ids stable
      allow update: if isInviteParticipant()
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.barId == resource.data.barId;

      allow delete: if false;
    }

   match /inviteCooldowns/{docId} {
  allow read: if signedIn();

  allow create: if signedIn()
    && request.resource.data.fromUid == request.auth.uid;

  allow update: if signedIn()
    && resource.data.fromUid == request.auth.uid
    && request.resource.data.fromUid == resource.data.fromUid
    && request.resource.data.toUid == resource.data.toUid
    && request.resource.data.barId == resource.data.barId;

  allow delete: if false;
}
    match /notifications/{docId} {
      allow read: if isNotificationRecipient();

      // sender can create notifications to someone else, recipient can only read/update their own
      allow create: if isNotificationSenderOnCreate()
        && request.resource.data.read == false;

      allow update: if isNotificationRecipient()
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.fromUid == resource.data.fromUid;

      allow delete: if false;
    }
  }
}